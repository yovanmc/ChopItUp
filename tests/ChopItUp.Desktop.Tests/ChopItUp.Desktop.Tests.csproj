<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <!-- HubChildTests drives HubChild's poll loop (Task.Delay(interval, TimeProvider, ct)) without a
         real wall-clock wait, the same seam ChopItUp.Hub.Tests uses. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ChopItUp.Desktop\ChopItUp.Desktop.csproj" />
    <!-- Test-only, mirrors tests\ChopItUp.Hub.Tests's own reference to this same project. Pins
         ProcessHubFactory's repeated "CHOPITUP_SHELL_TOKEN" literal (no src-to-src reference exists)
         against ChopItUp.Hub.Hosting.HubOptions.ShellTokenEnvVar. -->
    <ProjectReference Include="..\..\src\ChopItUp.Hub\ChopItUp.Hub.csproj" />
  </ItemGroup>
</Project>
