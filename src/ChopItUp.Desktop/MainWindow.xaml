<Window x:Class="ChopItUp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Chop It Up"
        Icon="chopitup.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="400"
        Background="#0E1013">

    <!-- The page draws the chrome. CaptionHeight=0 because WebView2's non-client-region
         support owns dragging (app-region: drag on the page's chrome row, styles.css .chrome), so
         there is no native caption region left for WindowChrome to claim.

         ResizeBorderThickness alone does not reach through the WebView2's own HWND child (measured
         Δwidth=0), so MainWindow.xaml.cs gives the OS resize-border logic a
         WPF-owned strip to hit-test by setting Web.Margin to 6 px while not maximized and 0 while
         maximized. The maximize inset is clamped to the monitor WORK area by ChromeHook
         (WM_GETMINMAXINFO) in code-behind; without it a WindowStyle=None maximize overhangs the
         taskbar by the invisible resize border.

         AllowsTransparency must stay False: the WebView2 is an HWND child and a layered window
         breaks its airspace.

         Background is the client's bg token (#0e1013) so the frame that shows for the instant before
         the WebView2 paints is the same colour as the boot page, not white. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <wv2:WebView2 x:Name="Web"/>
    </Grid>
</Window>
