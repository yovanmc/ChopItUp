<Application x:Class="ChopItUp.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- No StartupUri: the window is built after the hub start or attach decision.
         ShutdownMode=OnExplicitShutdown, because Close hides the window rather than closing the
         application; the default OnLastWindowClose would exit the process the first time the owner
         hid the window to the tray. Every real exit goes through App.Shutdown explicitly
         (WebView2/runtime failures, the show/quit verbs with no primary, QuitAsync). -->
</Application>
